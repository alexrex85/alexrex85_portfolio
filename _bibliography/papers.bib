@inproceedings{re_ville_2021,
	address = {Udine},
	title = {Ville in {Plinio} il {Giovane}, orizzonte reale o spazio ideale?},
	volume = {3},
	shorttitle = {Ville in {Plinio} il {Giovane}},
	url = {https://hdl.handle.net/11390/1210941},
	abstract = {The description of the villas and the activities there done runs through the entire correspondence of Pliny the Younger: this theme allows us to sketch an interesting analysis of society and culture of the Trajan era. The possession of extra-urban manors constitutes a real status symbol: Pliny provides significant information on their structure. They are the privileged place for the exercise of otia, among which literary activity plays the main role. In general, Pliny proposes a model of life marked by the search for moderation, that allows to gain that peace disturbed by the frenetic activities typical of Rome.},
	booktitle = {Centro e periferia nella letteratura latina di {Roma} imperiale},
