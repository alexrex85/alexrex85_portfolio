@article{re_iam_2021,
	title = {Iam {Christe} tolle mentium. {Note} esegetiche tra mondo classico e cristiano},
	volume = {41},
	shorttitle = {Iam {Christe} tolle mentium},
	url = {https://hdl.handle.net/11390/1218392},
	abstract = {Iam Christe tolle mentium constitutes a peculiar Ambrosian recension of the hymn Iam Christe sol iustitiae, which is also well attested in the Breviarium Romanum. A careful analysis of the themes addressed in this brief composition reveals a rich intertextual network ranging from clear references to Roman religious culture, upon which the innovations of Christian preaching were grafted, to elements of the Jewish tradition. The lucid clarity of its exposition helps to define the themes of purification and asceticism characteristic of the Lenten season, which merge with the renewal of nature associated with spring.},
	number = {2},
