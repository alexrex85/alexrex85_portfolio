@inproceedings{re_il_2022,
	address = {Udine},
	title = {Il plurilinguismo in {Dante}},
	url = {https://hdl.handle.net/11390/1226297},
	abstract = {De vulgari eloquentia is Dante's unfinished Latin treatise on human linguistic faculties. Written at the beginning of the 14th century, it constitutes one of the earliest scientific reflections on the European vernacular languages. After identifying the origin of the plurality of languages in the confusion caused by God to halt the construction of the Tower of Babel, on the basis of the form of the affirmative adverb, Dante groups the European languages into the Germanic, Greek, and Romance branches. Within the latter group, he further distinguishes three varieties: the langue d’oc, the langue d’oïl, and the lingua di sì. Finally, with regard to the Italian peninsula, he surveys fourteen dialectal varieties which, to a considerable extent, can be compared with the linguistic areas identified by modern dialectological scholarship.},
	booktitle = {Cultura in {Friuli} {VII}. {Settimana} della cultura friulana - {Setemane} de culture furlane (18-28 ottobre 2020, 6-16 maggio 2021)},
	publisher = {Società Filologica Friulana},
	author = {Re, Alessandro},
	editor = {Varutti, Marta and Visintin, Maria Chiara},
	year = {2022},
	pages = {451--471},
