@book{re_genus_2020,
	address = {Innsbruck},
	series = {Innsbrucker {Beiträge} zur {Sprachwissenschaft}},
	title = {Genus compositicium. {La} composizione nominale latina},
	shorttitle = {Genus compositicium},
	url = {https://hdl.handle.net/11390/1210943},
	abstract = {The widespread assumption that the Latin language is inherently poor in nominal compounds is clearly challenged by a careful examination of the Latin authors. Starting with a historical investigation aimed at determining how linguistic scholarship, from the Hellenistic period to the present day, has accounted for the phenomenon of nominal compounding, this study identifies the tools of generative grammar as an exemplary model capable of scientifically explaining the rules by which simple words are combined to form lexemes with new meanings. Finally, it relates the typology of nominal compounds to the literary genres in which they are employed: both synchronically and diachronically, it emerges that certain compositional patterns have always been rare, whereas the productivity of others increases over time depending on the genre in which they occur.},
	number = {165},
	publisher = {Institut für Sprachwissenschaft der Universität Innsbruck},
	author = {Re, Alessandro},
	year = {2020},
	annote = {Volume: https://mega.nz/file/Zs5XgCBR\#BSGo23v13P3sHMMJaukvZZZ5Wlwx10CJNSOlnJKrM00
},
}

@article{re_glossae_2014,
	title = {Glossae {Latino}-{Anglicae}: il lessico ittico nei glossari anglosassoni},
	volume = {3},
	shorttitle = {Glossae {Latino}-{Anglicae}},
	doi = {10.4424/lam32014-6},
	abstract = {This paper deals with the lexicon of aquatic animals in Anglo-Saxon as we can infer it from old English glossaries. A good number of glossaries dating back to the Middle Ages are preserved; in them we can find either Latin-Latin or bilingual glosses, in particular Latin-Old English. In this paper I will only focus on the latter group. In Section 1 (Introduction) I outline a sort of status quo in relation to the various typologies of documents containing Old English glosses, and discussing whether different works supposed distinct kind of users. The article also deals with the problem of sources of lemmata attested in the glossaries I studied. In Section 2 I briefly give the list of the glossaries I analysed and I focus on the dating of the texts and their edition. Section 3 contains the most important part of this paper: the Old English glosses to a large amount of Latin fishnames are gathered and classified. My main aim is discussing etymological problems with special regard to the other Germanic languages and possible links with Indo-European idioms, both from a diachronic and a synchronic point of view. The conclusion – in Section 4 – tries to sum up and give an overview of this lexical field.},
	journal = {Lingue antiche e moderne},
	author = {Re, Alessandro},
	year = {2014},
	pages = {141--180},
	annote = {Articolo: https://mega.nz/file/xtwFgJAZ\#CD\_S24yDHXzD-lWMVB5MZYQ9KaFz2RvtpHLxzFCliV8
},
}

@phdthesis{re_genus_2013,
	type = {Tesi di dottorato},
	title = {Genus compositicium. {La} composizione nominale in latino},
	shorttitle = {Genus compositicium},
	url = {http://hdl.handle.net/11390/1132330},
	abstract = {This dissertation examines nominal compounding in the Latin language. Using the tools of generative grammar, it is possible to define in an almost ‘mathematical’ way the patterns according to which Latin nominal and verbal roots can be combined to create a variety of neologisms, some of which are widespread in everyday use (e.g. agricola, beneficus, artifex), while others are deliberately recherché and poetically marked (e.g. Troiugena, frugiferens, flammicomus). An analysis of a group of Latin authors dating from the 1st century AD to Late Antiquity confirms that the distribution of compositional patterns and their use are closely connected to the literary genre in which they occur.},
	school = {Università di Udine},
	author = {Re, Alessandro},
	year = {2013},
	annote = {Tesi di dottorato: https://mega.nz/folder/9tR3WTiQ\#yNdpyZT020AyxEGKQpKB5w
Altri materiali: https://mega.nz/folder/xw4knLBD\#jzwTXoBB4j6-M3YrwXmlkg
},
}

@inproceedings{oniga_between_2025,
	address = {Berlin – Boston},
	title = {Between {Linguistics} and {Stylistics}: {Nominal} {Compounding} and {Literary} {Genre} in {Latin}},
	volume = {I},
	shorttitle = {Between {Linguistics} and {Stylistics}},
	doi = {10.1515/9783111332956-008},
	abstract = {After having collected linguistic data from the 3rd century B.C. to the 5th century A.D., we worked out a typological classification of Latin nominal compounds based on a simplified Construction Grammar perspective. Then, we looked for links between the different types of compounds and the literary genre of the text in which they are used. The analysis shows that certain types of compounds (i.e. bahuvrīhi and most of nomina agentis) are mainly attested in high poetry, especially epics, while other types (i.e. nomina actionis and nominal abstracta) are primarily used in prose. This proves that, although morphological constructions are abstract entities whose existence in the linguistic competence of the speakers may only be supposed, they produce evident consequences in the stylistic nature of Latin literary texts.},
	booktitle = {Exploring {Latin}: {Structures}, {Functions}, {Meaning}},
	publisher = {De Gruyter},
	author = {Oniga, Renato and Re, Alessandro},
	editor = {Pultrová, Lucie and Vaníková, Martina},
	year = {2025},
	pages = {121--138},
	annote = {Articolo: https://mega.nz/file/ktg3HKwD\#VkIWCToOydYao9tLIyinh9hl8wN4GgRsLPpH5Tpf2ek
},
}

@article{oniga_lanalyse_2017,
	title = {L’analyse synchronique des composés nominaux du latin hier et aujourd’hui},
	volume = {86},
	shorttitle = {L’analyse synchronique des composés nominaux},
	doi = {10.3406/antiq.2017.3907},
	abstract = {The study of nominal compounds in classical antiquity shows some similarities with contemporary linguistics, especially generative grammar. Ancient grammarians wished to develop a synchronic typology based on the inflectional features of the two members of the compound and the presence of the derivation. The introduction of syntactic criteria and the identification of the special characteristics of bahuvrīhi compounds are the main achievements of the Indian grammarians. Starting from a fundamentally Sanskrit typology, Latin linguistics in the 19th and 20th century attempted to develop new theories.},
	journal = {L’Antiquité Classique},
	author = {Oniga, Renato and Re, Alessandro},
	year = {2017},
	pages = {39--58},
	annote = {Articolo: https://mega.nz/file/1p4m3BhR\#nPVjXrdRxfsuPrYlONasD2rCsshoAdDX6MgmXck1Svw
},
}

@article{lorusso_origini_2022,
	title = {Le origini latine dei verbi sintagmatici romanzi: osservazioni sull'uso dell'avverbio foras},
	volume = {32},
	shorttitle = {Le origini latine dei verbi sintagmatici romanzi},
	url = {https://www.analisilinguisticaeletteraria.eu/index.php/ojs/article/view/508},
	abstract = {This article intends to investigate those Latin structures that prelude to Romance phrasal verbs. After having defined the object of study and having shown the Italian and Friulian data (§ 1), the various explanations of the phenomenon are presented, i.e. the Germanic hypothesis, the evolution within the framework of Greenberg’s typology, and the opposition between satellite-framed and verb-framed languages according to Talmy’s theory (§ 2). Then, the use of the adverb foras in Latin authors from the archaic period to late antiquity is analyzed in detail, trying to elaborate general lines of diachronic, sociolinguistic and stylistic variation (§ 3). Finally, a new interpretation of the constructions of movement verbs modified with prefixes, complements and adverbs is proposed, by means of the formalization of three lexico-sitnactic structures that follow one another along the entire span of the history of Latin (§ 4). The conclusion is that the last phase, although still compatible with classical Latin grammar, represents the premise for the development of Romance phrasal verbs (§ 5).},
	number = {3},
	journal = {L'Analisi Linguistica e Letteraria},
	author = {Lorusso, Paolo and Oniga, Renato and Re, Alessandro},
	year = {2022},
	pages = {5--34},
	annote = {Articolo: https://mega.nz/file/E8RCDLgb\#ck0-C1bnV6Srv4LsEh34zbhLYmFDDP5dmEAlPsqgNMw
Materiali: https://mega.nz/folder/ZxAQSSDT\#SI6FP1iraXOysZD3IbnjkA
Assegno 2022: https://mega.nz/file/ZlBGibbZ\#iknQW-Y-8\_Xz0Mr-\_XrA\_ebSoIafnNgJZuodhDELxT0
},
}

