Materiali: https://mega.nz/folder/80Z3GB6Z\#-Sz0aSMAGMXhJF6LVDHsaQ
},
}

@article{re_applications_2026,
	title = {Applications of {Digital} {Analysis} {Techniques} to {Classical} {Languages} and {Literatures}},
	volume = {10},
	doi = {10.60923/issn.2532-8816/22980},
	abstract = {This article offers a survey of recent studies on the application of Natural Language Processing techniques to classical philology, with particular emphasis on Latin epic poetry of the 1st century AD. Although originally designed for the analysis of modern languages, the algorithms developed in computational linguistics over the past three decades – ranging from Latent Semantic Allocation and Latent Dirichlet Allocation to the more recent Transformer models based on Neural Networks – have transformed intertextual research through the practice of Topic Extraction. Particular attention is given to cases aimed at detecting situational correspondences even in the absence of co-occurring vocabulary. The examples discussed confirm both the efficacy of this approach and the convergence between ‘traditional’ philological methods and computational-linguistic techniques.},
	number = {24},
	journal = {Umanistica Digitale},
	author = {Re, Alessandro},
	year = {2026},
	pages = {263--288},
	annote = {Articolo: https://mega.nz/file/8pZWkJQb\#Ov3zb6OTrf6UdXS76B4y7WhFALvgHd5lOxhmNETYTVI
Materiali: https://mega.nz/folder/B4RRmAKJ\#r3FV2VZt7ZnYYLSVjtE4Yg
},
}

@phdthesis{re_osservazioni_2007,
	address = {Milano},
	type = {Tesi di laurea triennale},
	title = {Osservazioni su alcuni glossari latino-antico inglese},
	abstract = {Bilingual glossaries provide valuable evidence of the lexical enrichment of the Anglo-Saxon language from as early as the early Middle Ages, the period in which the earliest written records of Old English began to appear. This dissertation explores two distinct lexical fields – kinship relations and fish-related terminology – which clearly demonstrate that the numerous neologisms attested in these glossaries are not mere borrowings, but rather reflect various expressive techniques aimed at conveying as clearly and precisely as possible the meaning of each expression.},
	school = {Università Cattolica del Sacro Cuore},
	author = {Re, Alessandro},
	year = {2007},
	annote = {Tesi di laurea: https://mega.nz/folder/p1Y1xYrI\#7saVV0Uv817uiVuM8\_sp6g
},
}

@phdthesis{re_studio_2010,
	address = {Milano},
	type = {Tesi di laurea magistrale},
	title = {Studio su alcuni composti in antico nordico},
	abstract = {Among the Germanic languages, Icelandic was – and in some respects still is – the language that has made the greatest use of nominal compounding as a means of enriching its vocabulary. This dissertation examines several semantic fields related to emotions, as expressed through nominal compounds formed with blóð “blood”, gall “bile”, milti “spleen”, and tár “tear.” In addition to determining whether the expressions under study can be related to the samāsa types of Old Indian, the dissertation investigates whether other ancient Germanic languages contain etymologically comparable expressions. Finally, it offers reflections on the formation of the Germanic poetic lexicon, also in relation to the broader tradition of the Indo-European peoples.},
	school = {Università Cattolica del Sacro Cuore},
	author = {Re, Alessandro},
	year = {2010},
	annote = {Tesi di laurea: https://mega.nz/folder/sxhx0LoZ\#UyE6u6JDYi1uKL1h1MnnZQ
},
}

